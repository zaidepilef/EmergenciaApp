# Solo servidor. NUNCA usar el prefijo NEXT_PUBLIC_ ni exponer estos valores en el cliente.
# Desarrollo local con Docker Compose (replica set rs0). Ver docs/development-setup.md.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&retryWrites=true&w=majority

# Nombre de la base lógica dentro del cluster.
MONGODB_DB=brigada_emergencias

# Secreto de Auth.js para firmar y cifrar sesiones. Mínimo 32 caracteres.
# Generar con: npx auth secret
AUTH_SECRET=

# URL pública de la aplicación. Auth.js la usa para construir callbacks.
AUTH_URL=http://localhost:3000

# Producción: usar MongoDB Atlas con una cadena mongodb+srv:// propia.
# No versionar credenciales reales.
