# URL del proyecto Supabase (local o remoto). No es un secreto.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clave anónima (anon key). Es pública por diseño; la protección real depende de RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública de la aplicación.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo para scripts de servidor. NUNCA usar el prefijo NEXT_PUBLIC_ ni exponerla en el cliente.
# SUPABASE_SERVICE_ROLE_KEY=
