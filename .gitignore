# Reglas comunes a todo el repositorio. Cada área (backend/, mobile/,
# packages/shared/) tiene además su propio .gitignore.

# dependencias y salidas
node_modules/
dist/
build/
coverage/

# variables de entorno (solo se versionan los ejemplos)
.env*
!.env.example
!.env.*.example

# claves y certificados
*.pem
*.key

# logs
*.log
npm-debug.log*

# sistema
.DS_Store
Thumbs.db
