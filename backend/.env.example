# Copiar a .env (no versionado). Valores SOLO para la base local de Docker
# (servicio "postgres" de compose.yaml, puerto 127.0.0.1:5433). No son secretos reales.
# En otros entornos estas variables las define devops-architect.

# Base de desarrollo. La API en ejecución usa SOLO DATABASE_URL (en servidores:
# el rol de la aplicación, emergencia_app).
DATABASE_URL="postgresql://emergencia_dev:dev_only_local_password@127.0.0.1:5433/emergencia_dev?schema=public"

# Opcional: URL del rol migrador para Prisma CLI (migrate deploy/status/reset).
# Si falta, Prisma usa DATABASE_URL. En local no hace falta (ambas serían el
# superusuario de desarrollo). En servidores la define devops-architect.
# MIGRATION_DATABASE_URL="postgresql://emergencia_migrator:<clave>@127.0.0.1:5433/emergencia_dev?schema=public"

# Base sombra de Prisma Migrate (migrate diff --from-migrations, migrate dev)
SHADOW_DATABASE_URL="postgresql://emergencia_dev:dev_only_local_password@127.0.0.1:5433/emergencia_shadow?schema=public"

# Base de pruebas de integración. Se BORRA y re-migra en cada corrida:
# las pruebas se niegan a correr si no apunta a localhost y a una base *_test.
TEST_DATABASE_URL="postgresql://emergencia_dev:dev_only_local_password@127.0.0.1:5433/emergencia_test?schema=public"
